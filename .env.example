# Copy this file to .env and fill in the values.
# .env is NOT committed (it is in .gitignore).

# Docker database user and password (choose your own; they are created on first start)
DB_USERNAME=
DB_PASSWORD=

# Trading 212 (read-only key, WITHOUT order permissions)
T212_API_KEY=
T212_API_SECRET=

# Finnhub
FINNHUB_API_KEY=
