# Copia este archivo como .env y rellena los valores.
# El .env NO se sube a git (está en .gitignore).

# Usuario y contraseña de la base de datos de Docker (los eliges tú; se crean la primera vez)
DB_USERNAME=
DB_PASSWORD=

# Trading 212 (key de solo lectura, sin permiso de órdenes)
T212_API_KEY=
T212_API_SECRET=

# Finnhub
FINNHUB_API_KEY=
